///|
/// Codegen tests: parse a fixture, generate bindings, assert the output
/// contains the expected MoonBit declarations and that naming/type mapping
/// helpers produce the documented output.

///|
/// `haystack.contains(needle)` — core `String` has no `contains` in this
/// toolchain, so test substrings via code-unit slicing.
fn contains_str(haystack : String, needle : String) -> Bool {
  let nl = needle.length()
  if nl == 0 {
    return true
  }
  for i in 0..<(haystack.length() - nl + 1) {
    if haystack[i:i + nl].equal_to_string(needle) {
      return true
    }
  }
  false
}

///|
test "generate hello-world bindings" {
  let out = generate(parse_or_fail(hello_world_wit))
  assert_eq(contains_str(out, "// Generated by moon-wit. DO NOT EDIT."), true)
  // interface greet
  assert_eq(contains_str(out, "pub fn greet(name : String) -> String"), true)
  assert_eq(contains_str(out, "abort(\"stub: greet\")"), true)
  // world import + inline export interface
  assert_eq(contains_str(out, "// import greet"), true)
  assert_eq(contains_str(out, "pub fn run() -> String"), true)
  assert_eq(out[out.length() - 2:], "}\n")
}

///|
test "generate greeting typedefs" {
  let out = generate(parse_or_fail(greeting_wit))
  // record
  assert_eq(contains_str(out, "pub struct Person {"), true)
  assert_eq(contains_str(out, "name : String"), true)
  assert_eq(contains_str(out, "age : UInt"), true)
  assert_eq(contains_str(out, "email : String"), true)
  // enum
  assert_eq(contains_str(out, "pub enum Tone {"), true)
  assert_eq(contains_str(out, "  Formal"), true)
  assert_eq(contains_str(out, "  Casual"), true)
  // variant with payload
  assert_eq(contains_str(out, "pub enum Animal {"), true)
  assert_eq(contains_str(out, "  Dog"), true)
  assert_eq(contains_str(out, "  Bird(String)"), true)
  assert_eq(contains_str(out, "  Fish"), true)
  // flags → UInt bitmask plus named constants
  assert_eq(contains_str(out, "pub type Permissions = UInt"), true)
  assert_eq(contains_str(out, "permissions_read : Permissions = 1U << 0"), true)
  assert_eq(
    contains_str(out, "permissions_write : Permissions = 1U << 1"),
    true,
  )
  assert_eq(
    contains_str(out, "permissions_execute : Permissions = 1U << 2"),
    true,
  )
  // resource → opaque external type
  assert_eq(contains_str(out, "#external"), true)
  assert_eq(contains_str(out, "type Session"), true)
  // alias
  assert_eq(contains_str(out, "pub type Id = UInt64"), true)
}

///|
test "generate greeting funcs" {
  let out = generate(parse_or_fail(greeting_wit))
  assert_eq(
    contains_str(out, "pub fn list_people(limit : UInt) -> @list.List[Person]"),
    true,
  )
  assert_eq(
    contains_str(out, "pub fn make_greeting(name : String, t : Tone) -> String"),
    true,
  )
  assert_eq(
    contains_str(out, "pub fn add_person(p : Person) -> Result[UInt64, String]"),
    true,
  )
  assert_eq(
    contains_str(out, "pub fn find(key : String) -> Option[String]"),
    true,
  )
  assert_eq(
    contains_str(out, "pub fn mix(a : Byte, b : Int) -> (UInt, Bool)"),
    true,
  )
  assert_eq(contains_str(out, "pub fn talk(s : Session) -> String"), true)
  assert_eq(contains_str(out, "  ignore(limit)"), true)
  assert_eq(contains_str(out, "  ignore(name)"), true)
}

///|
test "generate named and multiple results as tuples" {
  let src =
    #|package x:y;
    #|interface i {
    #|  f: func() -> (a: u32, b: string)
    #|  g: func() -> (u32, string)
    #|  h: func() -> u32
    #|}
  let p = parse_or_fail(src)
  let out = generate(p)
  assert_eq(contains_str(out, "pub fn f() -> (UInt, String)"), true)
  assert_eq(contains_str(out, "pub fn g() -> (UInt, String)"), true)
  assert_eq(contains_str(out, "pub fn h() -> UInt"), true)
}

///|
test "needs_list_import detects list usage" {
  assert_eq(needs_list_import(parse_or_fail(greeting_wit)), true)
  assert_eq(needs_list_import(parse_or_fail(hello_world_wit)), false)
}

///|
test "generate_moon_pkg content" {
  assert_eq(
    generate_moon_pkg(true),
    "import {\n  \"moonbitlang/core/list\",\n}\n",
  )
  assert_eq(generate_moon_pkg(false), "\n")
}

///|
test "naming helpers" {
  assert_eq(type_name("hello-world"), "HelloWorld")
  assert_eq(type_name("session"), "Session")
  assert_eq(case_name("not-animal"), "NotAnimal")
  assert_eq(field_name("hello-world"), "hello_world")
  assert_eq(field_name("limit"), "limit")
  assert_eq(type_name("%interface"), "Interface")
  assert_eq(field_name("%type"), "type_")
  assert_eq(field_name("%match"), "match_")
}

///|
test "generate escaped identifiers as valid MoonBit names" {
  let src =
    #|package test:escaped;
    #|interface %interface {
    #|  %type: func(%match: string) -> string;
    #|}
  let out = generate(parse_or_fail(src))
  assert_eq(contains_str(out, "pub fn type_(match_ : String) -> String"), true)
  assert_eq(contains_str(out, "ignore(match_)"), true)
}

///|
test "generate direct world functions" {
  let pkg = parse_or_fail(calculator_wit)
  let out = generate(pkg)
  assert_eq(contains_str(out, "// import log"), true)
  assert_eq(contains_str(out, "pub fn log(message : String) -> Unit"), true)
  assert_eq(contains_str(out, "// export add"), true)
  assert_eq(contains_str(out, "pub fn add(a : Int, b : Int) -> Int"), true)
  assert_eq(
    contains_str(
      out, "pub fn batch_add(values : @list.List[Int]) -> @list.List[Int]",
    ),
    true,
  )
  assert_eq(needs_list_import(pkg), true)
}

///|
test "generate resource functions" {
  let out = generate(parse_or_fail(resource_wit))
  assert_eq(contains_str(out, "#external\ntype Counter"), true)
  assert_eq(
    contains_str(out, "pub fn counter_new(initial : UInt) -> Counter"),
    true,
  )
  assert_eq(contains_str(out, "pub fn counter_max() -> UInt"), true)
  assert_eq(
    contains_str(out, "pub fn Counter::increment(amount : UInt) -> UInt"),
    true,
  )
}

///|
test "generate world includes as composition comments" {
  let out = generate(parse_or_fail(include_wit))
  assert_eq(contains_str(out, "// include wasi:cli/run;"), true)
  assert_eq(contains_str(out, "// include local:shared/base;"), true)
  assert_eq(
    contains_str(
      out, "// include local:shared/legacy with {old-name as new-name, run as start};",
    ),
    true,
  )
  assert_eq(needs_list_import(parse_or_fail(include_wit)), false)
}

///|
test "generate versioned external paths" {
  let out = generate(parse_or_fail(wasi_paths_wit))
  assert_eq(contains_str(out, "// use wasi:io/streams@0.2.0."), true)
  assert_eq(contains_str(out, "// import wasi:cli/environment@0.2.0"), true)
  assert_eq(contains_str(out, "// export wasi:cli/run@0.2.0 as run"), true)
  assert_eq(contains_str(out, "// include wasi:cli/command@0.2.0;"), true)
}

///|
/// Parse `type t = <wit>;` and return the alias's referenced type. Test
/// binaries see enum constructors as read-only in this toolchain, so build
/// `WitType` values through the parser instead of writing constructors.
fn alias_ty(wit_ty : String) -> WitType {
  let p = parse_or_fail(
    "package x:y;\ninterface i {\n  type t = \{wit_ty};\n}\n",
  )
  match p.items[0] {
    Interface(iface) =>
      match iface.items[0] {
        Type(def) =>
          match def.kind {
            Alias(t) => t
            _ => abort("expected type alias")
          }
        _ => abort("expected typedef")
      }
    _ => abort("expected interface")
  }
}

///|
test "type mapping" {
  assert_eq(type_str(alias_ty("u8")), "Byte")
  assert_eq(type_str(alias_ty("u16")), "UInt16")
  assert_eq(type_str(alias_ty("u32")), "UInt")
  assert_eq(type_str(alias_ty("u64")), "UInt64")
  assert_eq(type_str(alias_ty("s8")), "Int")
  assert_eq(type_str(alias_ty("s16")), "Int16")
  assert_eq(type_str(alias_ty("s32")), "Int")
  assert_eq(type_str(alias_ty("s64")), "Int64")
  assert_eq(type_str(alias_ty("f32")), "Float")
  assert_eq(type_str(alias_ty("f64")), "Double")
  assert_eq(type_str(alias_ty("char")), "Char")
  assert_eq(type_str(alias_ty("string")), "String")
  assert_eq(type_str(alias_ty("bool")), "Bool")
  assert_eq(type_str(alias_ty("list<u32>")), "@list.List[UInt]")
  assert_eq(type_str(alias_ty("option<string>")), "Option[String]")
  assert_eq(type_str(alias_ty("result<u64, string>")), "Result[UInt64, String]")
  assert_eq(type_str(alias_ty("result<_, string>")), "Result[Unit, String]")
  assert_eq(type_str(alias_ty("tuple<u32, bool>")), "(UInt, Bool)")
  assert_eq(type_str(alias_ty("borrow<session>")), "Session")
  assert_eq(type_str(alias_ty("own<session>")), "Session")
  assert_eq(type_str(alias_ty("future<string>")), "WitFuture[String]")
  assert_eq(type_str(alias_ty("future<_>")), "WitFuture[Unit]")
  assert_eq(type_str(alias_ty("stream<u8>")), "WitStream[Byte]")
}

///|
test "generate async scaffold handles" {
  let src =
    #|package test:async;
    #|interface tasks {
    #|  wait: func() -> future<list<u8>>;
    #|  events: func() -> stream<string>;
    #|}
  let pkg = parse_or_fail(src)
  let out = generate(pkg)
  assert_eq(contains_str(out, "#external\ntype WitFuture[T]"), true)
  assert_eq(contains_str(out, "#external\ntype WitStream[T]"), true)
  assert_eq(
    contains_str(out, "pub fn wait() -> WitFuture[@list.List[Byte]]"),
    true,
  )
  assert_eq(contains_str(out, "pub fn events() -> WitStream[String]"), true)
  assert_eq(needs_list_import(pkg), true)
}

///|
test "nested list dependency detection" {
  let sources = [
    "option<list<u8>>", "result<_, list<string>>", "tuple<bool, list<u32>>", "future<list<u16>>",
    "stream<list<u64>>",
  ]
  for wit_type in sources {
    let src = "package test:nested; interface api { f: func() -> \{wit_type}; }"
    assert_eq(needs_list_import(parse_or_fail(src)), true)
  }
}

///|
test "resource method list dependency detection" {
  let src =
    #|package test:resource-list;
    #|interface api {
    #|  resource reader { read: func() -> list<u8>; }
    #|}
  assert_eq(needs_list_import(parse_or_fail(src)), true)
}

///|
test "named result maps to its MoonBit type" {
  let src =
    #|package test:named;
    #|interface api { status: func() -> (code: u16); }
  let out = generate(parse_or_fail(src))
  assert_eq(contains_str(out, "pub fn status() -> UInt16"), true)
}
